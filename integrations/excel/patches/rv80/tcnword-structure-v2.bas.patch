-' Resolve the canonical MOP/PM/email family for a TCN row. New rows carry the
-' PO in column C and may carry an operational alias in X; the alias wins when
-' present. PO-only rows use the same registry as ERP project setup. Keep this
-' registry deliberately explicit: an unknown PO must remain unresolved rather
-' than being guessed into a template family.
+Private Function IsErpProjectReference_Enhanced(ByVal value As String) As Boolean
+    Dim token As String
+    token = Trim$(value)
+    IsErpProjectReference_Enhanced = (Len(token) > 0 And IsNumeric(token)) Or (UCase$(Left$(token, 3)) = "WO-")
+End Function
+
+' ERP owns the canonical family for a PO. A Builder profile/stream cannot override it.
+' Alias-only legacy rows retain their existing template-family normalization.
