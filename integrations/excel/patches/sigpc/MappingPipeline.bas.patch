+' PO and WO scope guard shared by the Tags reader and its P/Q writer.
+Private Function MP_ErpTagsRowInScope(ByVal ws As Worksheet, ByVal sourceRow As Long, ByVal ctx As Object) As Boolean
+    Dim raw As Variant, i As Long, site As String, po As String, wo As String, candidates As Object
+    Dim wt As String, requireWt As Boolean, item As String
+    item = Trim$(CStr(ws.Cells(sourceRow, "D").Value2))
+    If Len(item) = 0 Or StrComp(item, "x", vbTextCompare) = 0 Then Exit Function
+    If Len(Trim$(CStr(ws.Cells(sourceRow, "G").Value2))) = 0 And Len(Trim$(CStr(ws.Cells(sourceRow, "I").Value2))) = 0 Then Exit Function
+    po = Trim$(CStr(ws.Cells(sourceRow, "A").Value2))
+    If Len(po) = 0 Or StrComp(po, Trim$(CStr(ctx("canonicalPO"))), vbTextCompare) <> 0 Then Exit Function
+    site = Trim$(CStr(ws.Cells(sourceRow, "C").Value2))
+    wo = Trim$(CStr(ws.Cells(sourceRow, "Q").Value2))
+    requireWt = MP_TagsWorkTypeRequired(ctx)
+    wt = Trim$(CStr(ws.Cells(sourceRow, "L").Value2))
+    If requireWt And Len(wt) = 0 Then Exit Function
+    Set candidates = CreateObject("Scripting.Dictionary"): candidates.CompareMode = vbTextCompare
+    raw = ctx("inputData")
+    For i = LBound(raw, 1) + 1 To UBound(raw, 1)
+        If MP_SiteKeysMatch(CStr(raw(i, 6)), site) And StrComp(Trim$(CStr(raw(i, 8))), po, vbTextCompare) = 0 Then
+            If requireWt Then
+                If UBound(raw, 2) < 26 Then Err.Raise vbObjectError + 2865, , "Mapping context has no Work Type column."
+                If StrComp(Trim$(CStr(raw(i, 26))), wt, vbTextCompare) <> 0 Then GoTo NextCandidate
+            End If
+            If Len(Trim$(CStr(raw(i, 4)))) > 0 Then candidates(Trim$(CStr(raw(i, 4)))) = True
+        End If
+NextCandidate:
+    Next i
+    If candidates.Count = 0 Then Exit Function
+    If InStr(1, wo, "MISSING", vbTextCompare) > 0 Then Err.Raise vbObjectError + 2863, , "Resolve the Tags WO MISSING marker for selected site " & site & " before export."
+    If candidates.Count > 1 Then Err.Raise vbObjectError + 2864, , "Tags need an explicit scope allocation: multiple WOs at site " & site
+    If Len(wo) > 0 And Not candidates.Exists(wo) Then Exit Function
+    MP_ErpTagsRowInScope = True
+End Function
