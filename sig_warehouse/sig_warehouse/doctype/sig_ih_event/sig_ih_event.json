  {"fieldname":"event_type","fieldtype":"Select","options":"OPEN\nRETURN\nUSE\nREASSIGN_OUT\nREASSIGN_IN","label":"Event Type","read_only":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"occurred_at","fieldtype":"Datetime","label":"Occurred At","read_only":1,"in_list_view":1},
  {"fieldname":"custodian","fieldtype":"Link","options":"Employee","label":"Custodian","read_only":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"custodian_name","fieldtype":"Data","label":"Custodian Name","read_only":1},
  {"fieldname":"item_code","fieldtype":"Link","options":"Item","label":"Item","read_only":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"qty","fieldtype":"Float","label":"Qty","read_only":1},
  {"fieldname":"condition","fieldtype":"Select","options":"Serviceable\nDamaged\nUnserviceable","default":"Serviceable","label":"Condition","read_only":1},
  {"fieldname":"source_stock_entry","fieldtype":"Link","options":"Stock Entry","label":"Source Stock Entry","read_only":1},
  {"fieldname":"source_se_detail","fieldtype":"Data","label":"Source Stock Entry Detail","read_only":1},
  {"fieldname":"source_row_key","fieldtype":"Data","label":"Source Row Key","read_only":1},
  {"fieldname":"operator","fieldtype":"Link","options":"User","label":"Operator","read_only":1},
  {"fieldname":"source_sub","fieldtype":"Data","label":"Source Operation","read_only":1,"description":"sig_declare_disposition operation_id that created this event."},
  {"fieldname":"remarks","fieldtype":"Small Text","label":"Remarks","read_only":1}
 ]
