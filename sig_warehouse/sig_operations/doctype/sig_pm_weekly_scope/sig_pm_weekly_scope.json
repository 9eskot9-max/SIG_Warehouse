{
  "doctype": "DocType",
  "name": "SIG PM Weekly Scope",
  "module": "SIG Operations",
  "custom": 0, "issingle": 0, "track_changes": 1, "engine": "InnoDB",
  "autoname": "hash",
  "field_order": ["employee", "employee_name", "project", "active"],
  "fields": [
    {"fieldname": "employee", "fieldtype": "Link", "label": "PM (Employee)", "options": "Employee", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "employee_name", "fieldtype": "Data", "label": "Name", "fetch_from": "employee.employee_name", "read_only": 1, "in_list_view": 1},
    {"fieldname": "project", "fieldtype": "Data", "label": "Project", "reqd": 1, "in_list_view": 1, "description": "Exact Project name whose sites this PM reviews."},
    {"fieldname": "active", "fieldtype": "Check", "label": "Active", "default": "1", "in_list_view": 1}
  ],
  "permissions": [
    {"role": "System Manager", "create": 1, "read": 1, "write": 1, "delete": 1, "report": 1, "export": 1},
    {"role": "Operations Manager", "create": 1, "read": 1, "write": 1, "delete": 1, "report": 1},
    {"role": "Projects Manager", "read": 1}
  ],
  "sort_field": "modified", "sort_order": "DESC"
}
